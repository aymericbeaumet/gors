{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gors.dev/schemas/performance-result-v4.json",
  "title": "gors paired native performance evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "resultId",
    "configurationFingerprint",
    "createdAt",
    "mode",
    "promotionEligible",
    "promotionBlockers",
    "fullClaimEligible",
    "fullClaimBlockers",
    "repository",
    "corpus",
    "protocol",
    "environment",
    "toolchains",
    "workloads"
  ],
  "properties": {
    "schemaVersion": { "const": 4 },
    "kind": { "const": "gors.performance.result" },
    "resultId": { "$ref": "#/$defs/sha256" },
    "configurationFingerprint": { "$ref": "#/$defs/sha256" },
    "createdAt": { "type": "string", "format": "date-time" },
    "mode": { "enum": ["baseline", "certification"] },
    "promotionEligible": { "type": "boolean" },
    "promotionBlockers": { "$ref": "#/$defs/stringArray" },
    "fullClaimEligible": { "type": "boolean" },
    "fullClaimBlockers": { "$ref": "#/$defs/stringArray" },
    "repository": {
      "type": "object",
      "required": ["commit", "dirty", "statusSha256"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitOid" },
        "dirty": { "type": "boolean" },
        "statusSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "corpus": {
      "type": "object",
      "required": ["version", "digest", "scenarioSupport"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sha256" },
        "scenarioSupport": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "required": [
        "lane",
        "artifactDriver",
        "artifactDriverProduction",
        "interval",
        "executionTimed",
        "samples",
        "sessions",
        "seed",
        "smoke",
        "minimumPromotionSamples",
        "minimumPromotionSessions",
        "calibrationVersion",
        "gorsCacheSchema",
        "ioByteCountersAvailable",
        "processTreeCountersAvailable",
        "stageFingerprintsAvailable"
      ],
      "properties": {
        "lane": { "const": "end_to_end_artifact" },
        "artifactDriver": { "const": "gors-build-production-v1" },
        "artifactDriverProduction": { "const": true },
        "interval": { "type": "string", "minLength": 1 },
        "executionTimed": { "const": false },
        "samples": { "type": "integer", "minimum": 1 },
        "sessions": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer" },
        "smoke": { "type": "boolean" },
        "minimumPromotionSamples": { "type": "integer", "minimum": 1 },
        "minimumPromotionSessions": { "type": "integer", "minimum": 1 },
        "calibrationVersion": { "type": "string", "minLength": 1 },
        "gorsCacheSchema": { "const": 4 },
        "ioByteCountersAvailable": { "type": "boolean" },
        "processTreeCountersAvailable": { "type": "boolean" },
        "stageFingerprintsAvailable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["hardwareClass", "dedicated", "jobBudget", "facts"],
      "properties": {
        "hardwareClass": { "type": "string", "minLength": 1 },
        "dedicated": { "type": "boolean" },
        "jobBudget": { "type": "integer", "minimum": 1 },
        "facts": { "type": "object" }
      },
      "additionalProperties": false
    },
    "toolchains": {
      "type": "object",
      "required": ["gors", "go"],
      "properties": {
        "gors": {
          "type": "object",
          "required": ["path", "version", "sha256", "runtimeContractIdentity"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "runtimeContractIdentity": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        "go": {
          "type": "object",
          "required": ["path", "goroot", "version", "sha256", "experiment"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "goroot": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "experiment": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workload" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitOid": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "compilerSummary": {
      "type": "object",
      "required": ["p50Ns", "p95Ns", "madNs"],
      "properties": {
        "p50Ns": { "type": "number", "exclusiveMinimum": 0 },
        "p95Ns": { "type": "number", "exclusiveMinimum": 0 },
        "madNs": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "pairSummary": {
      "type": "object",
      "required": ["sampleCount", "gors", "go", "pairedRatio"],
      "properties": {
        "sampleCount": { "type": "integer", "minimum": 1 },
        "gors": { "$ref": "#/$defs/compilerSummary" },
        "go": { "$ref": "#/$defs/compilerSummary" },
        "pairedRatio": { "type": "object" }
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "required": [
        "wallNs",
        "normalizedWallNs",
        "userCpuNs",
        "systemCpuNs",
        "peakRssBytes",
        "bytesRead",
        "bytesWritten",
        "ioInputBlocks",
        "ioOutputBlocks",
        "processCount",
        "directProcessCount",
        "artifactBytes",
        "commands",
        "internalTimings"
      ],
      "properties": {
        "wallNs": { "type": "integer", "exclusiveMinimum": 0 },
        "normalizedWallNs": { "type": "number", "exclusiveMinimum": 0 },
        "userCpuNs": { "type": "integer", "minimum": 0 },
        "systemCpuNs": { "type": "integer", "minimum": 0 },
        "peakRssBytes": { "type": "integer", "minimum": 0 },
        "bytesRead": { "type": ["integer", "null"], "minimum": 0 },
        "bytesWritten": { "type": ["integer", "null"], "minimum": 0 },
        "ioInputBlocks": { "type": "integer", "minimum": 0 },
        "ioOutputBlocks": { "type": "integer", "minimum": 0 },
        "processCount": { "type": ["integer", "null"], "minimum": 1 },
        "directProcessCount": { "type": "integer", "minimum": 1 },
        "artifactBytes": { "type": "integer", "minimum": 1 },
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/command" }
        },
        "internalTimings": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": [
        "stage",
        "argv",
        "cwd",
        "environment",
        "durationNs",
        "exitCode",
        "stdoutBase64",
        "stderrBase64"
      ],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "cwd": { "type": "string", "minLength": 1 },
        "environment": { "type": "object" },
        "durationNs": { "type": "integer", "minimum": 0 },
        "exitCode": { "type": "integer" },
        "stdoutBase64": { "type": "string" },
        "stderrBase64": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sample": {
      "type": "object",
      "required": [
        "pairIndex",
        "order",
        "gors",
        "go",
        "behavior",
        "setupValidation"
      ],
      "properties": {
        "pairIndex": { "type": "integer", "minimum": 1 },
        "order": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "enum": ["gors", "go"] }
        },
        "gors": { "$ref": "#/$defs/measurement" },
        "go": { "$ref": "#/$defs/measurement" },
        "behavior": { "type": "object" },
        "setupValidation": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "required": ["sessionIndex", "calibration", "samples"],
      "properties": {
        "sessionIndex": { "type": "integer", "minimum": 1 },
        "calibration": { "type": "object" },
        "samples": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sample" } }
      },
      "additionalProperties": false
    },
    "workload": {
      "type": "object",
      "required": [
        "workloadId",
        "scenario",
        "validation",
        "hostHealthPassed",
        "sessions",
        "summary",
        "achievement"
      ],
      "properties": {
        "workloadId": { "type": "string", "minLength": 1 },
        "scenario": { "enum": ["cold", "no_op", "leaf_edit"] },
        "validation": { "type": "object" },
        "hostHealthPassed": { "type": "boolean" },
        "sessions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/session" } },
        "summary": {
          "type": "object",
          "required": ["raw", "normalized"],
          "properties": {
            "raw": { "$ref": "#/$defs/pairSummary" },
            "normalized": { "$ref": "#/$defs/pairSummary" }
          },
          "additionalProperties": false
        },
        "achievement": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
